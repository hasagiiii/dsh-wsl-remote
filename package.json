{
  "name": "@local/dsh-wsl-remote",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "WSL remote connections for DeepSeek Harness, like the Codex desktop app: each WSL distribution runs its own dsh beside the Windows one, reached through wsl.exe stdio, optionally sharing the Windows sign-in.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasagiiii/dsh-wsl-remote.git"
  },
  "scripts": {
    "test": "node test/unit.mjs",
    "test:remote": "node test/remote.mjs"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.2.2-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "server/agent.mjs",
    "server/launch.sh",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
