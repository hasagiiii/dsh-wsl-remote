{
  "name": "@local/dsh-wsl-remote",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "description": "WSL and SSH remote hosts for DeepSeek Harness, like the Codex desktop app: each WSL distribution or SSH server runs your own dsh (its ~/.dsh, models, plugins and Linux files), and its workspaces and sessions appear in the Windows window beside the Windows ones.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasagiiii/dsh-wsl-remote.git"
  },
  "scripts": {
    "test": "node test/unit.mjs",
    "test:models": "node --test test/models.mjs test/model-plugins.mjs test/client-models.mjs",
    "test:ssh": "node --test --test-isolation=none test/ssh.mjs test/client-ssh.mjs test/plugin-sync.mjs",
    "test:remote": "node test/remote.mjs",
    "test:ssh-remote": "node test/ssh-remote.mjs",
    "test:startup": "node --test --test-isolation=none test/bridge-cache.mjs test/bridge-startup.mjs"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.2.2-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-api-gateway": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-typert-registry": { "optional": true }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "server/agent.mjs",
    "server/launch.sh",
    "server/dsh-harness.sh",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "docs/images/*.png",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  }
}
